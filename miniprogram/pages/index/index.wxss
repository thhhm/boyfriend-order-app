.page { min-height: 100vh; }
.hero { background: linear-gradient(135deg, #fff4ef, #fff9ed 55%, #ffe9ea); padding: 70rpx 40rpx 62rpx; }
.eyebrow, .section-kicker { color: #ca858b; font-size: 22rpx; font-weight: 700; letter-spacing: 3rpx; }
.names { color: #b8757c; font-size: 34rpx; font-weight: 600; letter-spacing: 5rpx; margin-top: 36rpx; }
.names text { color: #e1a0a2; font-size: 28rpx; margin: 0 12rpx; }
.hero-title { color: #4b3435; font-family: serif; font-size: 66rpx; line-height: 1.35; margin: 30rpx 0 22rpx; }
.hero-title text { color: #cf7e87; display: block; }
.hero-copy { color: #80686a; font-size: 26rpx; line-height: 1.9; }
.hero-button, .primary { background: #da8990; border-radius: 50rpx; box-shadow: 0 10rpx 24rpx rgba(204,120,128,.25); color: white; font-size: 28rpx; font-weight: 700; margin: 35rpx 0 0; padding: 18rpx 36rpx; }
.hero-button text { background: #fff; border-radius: 50%; color: #d57f85; font-size: 20rpx; margin-left: 10rpx; padding: 4rpx 9rpx; }
.hero-note { color: #a28686; font-size: 22rpx; margin-top: 35rpx; }
.content { padding: 70rpx 30rpx 100rpx; }
.section-title { color: #493637; font-size: 38rpx; font-weight: 700; margin: 14rpx 0 34rpx; }
.section-title text { color: #df9295; }
.toolbar { margin-bottom: 28rpx; }
.tabs { white-space: nowrap; width: 100%; }
.tab { background: transparent; color: #a38787; display: inline-block; font-size: 25rpx; margin-right: 8rpx; padding: 14rpx 22rpx; }
.tab.active { background: #f9dfe0; border-radius: 99rpx; color: #ad666c; font-weight: 700; }
.search { background: white; border: 1px solid #f0e0dd; border-radius: 16rpx; color: #604b4c; font-size: 25rpx; margin-top: 18rpx; padding: 20rpx; }
.service-card { background: #fff; border: 1px solid #f1dcd7; border-radius: 26rpx; box-shadow: 0 8rpx 24rpx rgba(187,148,142,.07); display: inline-block; margin: 0 16rpx 18rpx 0; padding: 28rpx; vertical-align: top; width: calc(50% - 8rpx); }
.service-card:nth-child(2n) { margin-right: 0; }
.card-top, .card-bottom { align-items: center; display: flex; justify-content: space-between; }
.emoji { background: #fff2eb; border-radius: 18rpx; display: inline-block; font-size: 40rpx; padding: 14rpx; }.tag { background: #fff5f2; border-radius: 6rpx; color: #d2918c; font-size: 18rpx; padding: 8rpx; }
.service-name { font-size: 29rpx; font-weight: 700; margin: 25rpx 0 12rpx; }.description { color: #9a8784; font-size: 22rpx; line-height: 1.6; min-height: 70rpx; }.card-bottom { border-top: 1px solid #f7ece8; margin-top: 24rpx; padding-top: 18rpx; }.detail { color: #b49d9b; font-size: 18rpx; }.add { background: transparent; color: #d07e84; font-size: 20rpx; padding: 0; }
.mask { background: rgba(61,40,40,.22); bottom: 0; left: 0; position: fixed; right: 0; top: 0; z-index: 10; }.cart-panel { background: #fffaf8; border-radius: 28rpx 28rpx 0 0; bottom: 0; max-height: 88vh; overflow-y: auto; padding: 38rpx 32rpx 50rpx; position: absolute; width: 100%; }.panel-head { align-items: flex-start; display: flex; justify-content: space-between; }.close { background: #fff0ed; border-radius: 50%; color: #a67876; font-size: 42rpx; height: 64rpx; line-height: 54rpx; width: 64rpx; }
.empty { color: #aa9391; padding: 110rpx 0; text-align: center; }.empty > text { display: block; font-size: 100rpx; margin-bottom: 26rpx; }.empty .primary { display: inline-block; font-size: 25rpx; margin-top: 30rpx; }
.cart-items { border-bottom: 1px solid #f0e1dd; margin-bottom: 28rpx; padding: 20rpx 0 10rpx; }.cart-item { align-items: center; display: flex; gap: 16rpx; margin-bottom: 24rpx; }.cart-emoji { background: #fff0ec; border-radius: 14rpx; font-size: 38rpx; padding: 14rpx; }.cart-info { flex: 1; font-size: 24rpx; }.cart-info text { color: #ac9693; display: block; font-size: 18rpx; margin-top: 7rpx; }.quantity { align-items: center; display: flex; gap: 14rpx; }.quantity button { background: white; border: 1px solid #efd9d6; border-radius: 50%; color: #c67f83; font-size: 28rpx; height: 48rpx; line-height: 42rpx; padding: 0; width: 48rpx; }.quantity text { font-size: 24rpx; }
.form-label { font-size: 24rpx; font-weight: 700; margin: 22rpx 0 10rpx; }.form-label text, .error { color: #d66f76; }.form-input { background: #fff; border: 1px solid #efdeda; border-radius: 14rpx; color: #604b4c; font-size: 24rpx; padding: 20rpx; width: 100%; }.note { min-height: 130rpx; }.error { font-size: 22rpx; margin-top: 14rpx; }.submit { width: 100%; }.mail-tip { background: #fff4e9; border-radius: 12rpx; color: #ad8b77; font-size: 20rpx; line-height: 1.6; margin-top: 22rpx; padding: 18rpx; }
.success { align-items: center; background: white; border: 1px solid #f4dddd; border-radius: 18rpx; bottom: 28rpx; box-shadow: 0 10rpx 35rpx rgba(92,53,53,.17); display: flex; gap: 16rpx; left: 30rpx; padding: 22rpx; position: fixed; right: 30rpx; z-index: 20; }.success-icon { background: #fff0ec; border-radius: 14rpx; font-size: 42rpx; padding: 14rpx; }.success view { flex: 1; font-size: 25rpx; font-weight: 700; }.success view text { color: #aa8d8c; display: block; font-size: 20rpx; font-weight: 400; margin-top: 8rpx; }.success button { background: transparent; color: #c4a5a2; font-size: 36rpx; padding: 0; }
@media (max-width: 360px) { .service-card { padding: 20rpx; }.service-name { font-size: 26rpx; }.detail { font-size: 16rpx; } }
